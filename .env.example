# Copie este arquivo, renomeie a cópia para ".env" (sem o .example) e preencha os valores.
# O arquivo .env NUNCA deve ser compartilhado ou subido pro GitHub (ele já está no .gitignore).

SECRET_KEY=troque-isso-por-um-texto-longo-aleatorio

# Cole aqui a "Connection String" do Supabase (Project Settings > Database > Connection String > URI)
# Lembre de trocar [YOUR-PASSWORD] pela senha que você criou.
DATABASE_URL=postgresql://postgres:SUA-SENHA-AQUI@db.xxxxxxxxxxxx.supabase.co:5432/postgres

STORAGE_BACKEND=supabase

# Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings > API > service_role key (clique no olhinho pra revelar)
SUPABASE_KEY=sua-service-role-key-aqui

SUPABASE_BUCKET=documentos
